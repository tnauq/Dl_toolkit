<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THROWAWAY. Delete this project and probe-compiled.yml once the findings
    land in FINDINGS.md — same lifecycle as Deadlock.Probe.Kv3.

    net9.0 because VRF 12.x requires it. References no other project of ours
    on purpose: a probe must not be able to break the shipping graph, and it
    must not tempt anyone into building on it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>probe-compiled</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ValveResourceFormat" Version="12.0.*" />
  </ItemGroup>

</Project>
