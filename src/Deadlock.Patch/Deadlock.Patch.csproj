<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net9.0 is FORCED by ValveResourceFormat 12.x (NU1202, probe-kv3
      2026-08-09). The rest of the solution is net8.0. Deadlock.Contracts is
      multi-targeted so this project can reference it; see the note there.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dl-patch</AssemblyName>
    <RootNamespace>Deadlock.Patch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ValveResourceFormat" Version="12.0.*" />
  </ItemGroup>

  <!--
    Folded 2026-08-12. The local envelope copy is gone: Envelope.cs now holds
    only the dl-patch PAYLOAD, and the outer shape plus the shared exit codes
    come from Contracts. The copy existed because Contracts' type names had not
    been read; they have now (dump-contracts, 2026-08-12).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Deadlock.Contracts\Deadlock.Contracts.csproj" />
    <!--
      Added 2026-08-12 for `dl-patch pack`. Format owns ValvePak and CI
      enforces the layer boundary, so pack is a front end over VpkWriter and
      touches no archive API itself. Format targets net8.0 and this project
      net9.0; a net9 project consuming a net8 one is fine, so no migration.
    -->
    <ProjectReference Include="..\Deadlock.Format\Deadlock.Format.csproj" />
  </ItemGroup>

</Project>
