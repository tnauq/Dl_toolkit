<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net9.0 is FORCED by ValveResourceFormat 12.x (NU1202, probe-kv3
      2026-08-09). The rest of the solution is net8.0. This is the first
      shipping tool to carry the split; if a second one does, migrate the
      whole solution rather than accumulating exceptions.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dl-patch</AssemblyName>
    <RootNamespace>Deadlock.Patch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ValveResourceFormat" Version="12.0.*" />
  </ItemGroup>

  <!--
    NOT referencing Deadlock.Contracts yet, and that is deliberate rather than
    an oversight: its envelope and exit-code type names have not been read, and
    guessing them is exactly the mistake FINDINGS correction 1 warns about.
    Envelope.cs below mirrors the shape locally. Folding it back into Contracts
    is a follow-up, and it is a rename, not a redesign.

    Note the framework split makes that fold non-trivial: a net9.0 project can
    reference a net8.0 one, but not the reverse.
  -->

</Project>
