<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net9.0, NOT net8.0 like the rest of the solution.
      ValveResourceFormat 12.0.4261 supports net9.0 only — confirmed by
      NU1202 on the probe-kv3 run 2026-08-09. This probe is standalone and
      references no project in the layer graph, so the mismatch is contained.
      If VRF is ever needed by Deadlock.Format, the SOLUTION moves to net9.0.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dl-probe-kv3</AssemblyName>
    <RootNamespace>Deadlock.Probe.Kv3</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Deliberately NOT referencing Deadlock.Contracts or Deadlock.Format.
    This is a throwaway probe. It answers one question and must not become
    a load-bearing part of the layer graph (D4). Delete it once FINDINGS
    records the answer.
  -->
  <ItemGroup>
    <!-- Floating patch version: the exact build is not the question here. -->
    <PackageReference Include="ValveResourceFormat" Version="12.0.*" />
  </ItemGroup>

</Project>
